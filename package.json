{
  "name": "parley-messenger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:backend": "node --test tests/backend.test.mjs",
    "gen:types": "supabase gen types typescript --local > src/lib/database.types.ts && oxfmt src/lib/database.types.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mui/icons-material": "^9.6.0",
    "@mui/material": "^9.6.0",
    "@supabase/supabase-js": "^2.119.2",
    "libphonenumber-js": "^1.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.90.0",
    "supabase": "^3.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
